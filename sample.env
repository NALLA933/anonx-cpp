# AnonXMusic (C++ port) — environment configuration.
# Copy to ".env" and fill in. Real environment variables override these.

# ---- required credentials ----

# from my.telegram.org/apps
API_ID=
API_HASH=

# from @BotFather on Telegram
BOT_TOKEN=
LOGGER_ID=

OWNER_ID=

# ---- assistant userbot configuration (TDLib native disk session) ----
# TDLib persists session keys to disk. It does NOT use Pyrogram string sessions.
SESSION_NAME=assistant
DATA_DIR=./data/tdlib_session

# Phone number of the assistant account (+1234567890).
# If left empty, anonx will interactively ask for it and the login OTP on first run.
PHONE_NUMBER=

# ---- optional: extra assistants (for multiple parallel voice chats) ----
SESSION_NAME2=assistant2
PHONE_NUMBER2=
SESSION_NAME3=assistant3
PHONE_NUMBER3=

# ---- storage (embedded SQLite replaces MongoDB) ----
DB_PATH=anonx.db

# ---- limits ----
DURATION_LIMIT=60      # max track length, in MINUTES
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20

# ---- links ----
SUPPORT_CHANNEL=https://t.me/fallenx
SUPPORT_CHAT=https://t.me/DevilsHeavenMF

# ---- feature flags (true/false) ----
AUTO_LEAVE=False
AUTO_END=False
THUMB_GEN=True
VIDEO_PLAY=True

# ---- localisation ----
LANG_CODE=en

# ---- media / assets ----
# space-separated; only batbin.me links are used
COOKIES_URL=
DEFAULT_THUMB=https://te.legra.ph/file/3e40a408286d4eda24191.jpg
PING_IMG=https://files.catbox.moe/haagg2.png
START_IMG=https://files.catbox.moe/zvziwk.jpg
