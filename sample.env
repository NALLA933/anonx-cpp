# AnonXMusic (C++ port) — environment configuration.
# Copy to ".env" and fill in. Real environment variables override these.

# ---- required ----

# from my.telegram.org/apps
API_ID=
API_HASH=

# from @BotFather
BOT_TOKEN=
LOGGER_ID=

OWNER_ID=

# assistant userbot session name or directory (TDLib disk session)
# TDLib does not use Pyrogram base64 string sessions. It uses interactive
# phone auth and persists session database keys directly to disk.
SESSION_NAME=assistant
DATA_DIR=./data/tdlib_session

# Optional: phone number for the assistant account (+1234567890).
# If left empty and interactive login is enabled, anonx prompts on CLI on startup.
PHONE_NUMBER=

# Legacy session alias (optional, for backwards compatibility)
SESSION=

# ---- optional: extra assistants (more parallel voice chats) ----
SESSION2=
SESSION3=
PHONE_NUMBER2=
PHONE_NUMBER3=

# ---- storage (replaces MONGO_URL from the Python version) ----
# Path to the SQLite database file. Backed up out-of-process via Litestream.
DB_PATH=anonx.db

# ---- limits ----
DURATION_LIMIT=60      # max track length, in MINUTES
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20

# ---- links ----
SUPPORT_CHANNEL=https://t.me/fallenx
SUPPORT_CHAT=https://t.me/DevilsHeavenMF

# ---- feature flags (true/false) ----
AUTO_LEAVE=False
AUTO_END=False
THUMB_GEN=True
VIDEO_PLAY=True

# ---- localisation ----
LANG_CODE=en

# ---- media / assets ----
# space-separated; only batbin.me links are used
COOKIES_URL=
DEFAULT_THUMB=https://te.legra.ph/file/3e40a408286d4eda24191.jpg
PING_IMG=https://files.catbox.moe/haagg2.png
START_IMG=https://files.catbox.moe/zvziwk.jpg
